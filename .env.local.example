# Chave da API do Gemini usada no cadastro assistido.
# Copie para .env.local (fora do Git) e preencha: https://aistudio.google.com/apikey
# Sem a chave, o cadastro funciona em modo simulado.
GEMINI_API_KEY=
# Opcional. Padrao: gemini-3.5-flash-lite (cota gratuita maior que a do gemini-flash-latest)
GEMINI_MODEL=
